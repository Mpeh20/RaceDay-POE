@model List<RaceDayMVC.Models.EventDto>
@{ ViewData["Title"] = "Upcoming Events"; }

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<h2>Upcoming Events</h2>
<div class="row mt-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                {
                    <img src="@ev.BannerImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" alt="Event Banner">
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@ev.Name</h5>
                    <p class="card-text">@ev.Date.ToShortDateString() - @ev.Location</p>
                    <p class="card-text"><small class="text-muted">Distance: @ev.Distance km | Type: @ev.EventType</small></p>
                    <form asp-action="Enroll" method="post" class="mt-auto">
                        <input type="hidden" name="eventId" value="@ev.Id" />
                        <div class="input-group">
                            <select name="category" class="form-select" required>
                                <option value="">Select Category...</option>
                                <option value="Elite">Elite</option>
                                <option value="Amateur">Amateur</option>
                            </select>
                            <button type="submit" class="btn btn-primary">Enroll</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
